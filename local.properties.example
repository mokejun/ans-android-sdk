# Copy to local.properties and set your Android SDK path.
# Android Studio default (macOS): /Users/<you>/Library/Android/sdk
# Android Studio default (Windows): C:\\Users\\<you>\\AppData\\Local\\Android\\Sdk
#
# Requirements: JDK 17+, Android SDK Platform 33, Build-Tools 30.0.3+
sdk.dir=/path/to/Android/Sdk
